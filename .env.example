# Copy this file to .env.local and fill in your keys. Never commit .env.local.
# The map, city search and restaurants use free OpenStreetMap services — no key needed.

# Server-only key for concerts, sports and shows
TICKETMASTER_API_KEY=

# Optional: a second ticketing source (free client ID at https://seatgeek.com/account/develop)
SEATGEEK_CLIENT_ID=

# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
