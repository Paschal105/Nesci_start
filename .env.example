# Copy this file to .env.local and fill in your keys. Never commit .env.local.

# Browser key for the map (Maps JavaScript API)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Server-only key for restaurants + city search (Places API (New))
GOOGLE_PLACES_API_KEY=

# Server-only key for concerts, sports and shows
TICKETMASTER_API_KEY=

# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
